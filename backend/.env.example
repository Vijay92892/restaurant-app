# Copy to .env for local development (scripts/dev_db.py creates one for you).
# In production, provide these via your secret manager / environment — never commit them.

ENV=development

# Runtime role: no superuser, no BYPASSRLS, owns no tables (see scripts/bootstrap_db.sql).
DATABASE_URL=postgresql+asyncpg://restaurant_app:CHANGE_ME@127.0.0.1:5432/restaurant
# Schema owner: used only to run migrations.
MIGRATION_DATABASE_URL=postgresql+asyncpg://restaurant_owner:CHANGE_ME@127.0.0.1:5432/restaurant
APP_DB_ROLE=restaurant_app

# Each at least 32 random characters, all different:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
PIN_HMAC_KEY=
PIN_ENC_KEY=

# Production requires redis + smtp.
RATE_LIMIT_BACKEND=memory
# Live updates to staff devices (/api/v1/ws/staff). With more than one API worker, use redis
# so an order placed on one worker reaches kitchen sockets held by another.
EVENT_BUS_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379/0
# WS_RECHECK_SECONDS=60
# WS_MAX_CONNECTIONS_PER_USER=5
MAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.com
# Staff password-reset links open this page (part of customer-web, same origin as the API).
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Restaurant self-registration: closed | invite | open. Invite codes: comma-separated, 16+ chars.
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODES=

# Customer ordering site. QR codes encode {PUBLIC_ORDER_BASE_URL}/t/{token}; serve the customer web
# app and /api/v1/public/* from this same origin. PUBLIC_WEB_ORIGINS is checked on customer writes.
PUBLIC_ORDER_BASE_URL=http://localhost:5173
PUBLIC_WEB_ORIGINS=
# Automatic PIN rotation runs inside the API (one leader per tick across workers).
PIN_SCHEDULER_ENABLED=true

# Data retention runs inside the API too (hourly, one leader across workers); `python -m app.cli
# purge` runs it once. Ended staff sessions and unused customer table sessions are deleted after
# these many days; audit logs after AUDIT_LOG_RETENTION_DAYS (the database refuses < 180).
RETENTION_ENABLED=true
# AUTH_RECORD_RETENTION_DAYS=30
# TABLE_SESSION_RETENTION_DAYS=30
# AUDIT_LOG_RETENTION_DAYS=365

# Menu photos are stored here (outside the code). Use a persistent volume in production,
# or serve MEDIA_URL_PREFIX from a CDN/reverse proxy pointing at this directory.
# MEDIA_ROOT=/var/lib/restaurant/media
# MAX_IMAGE_UPLOAD_BYTES=5242880

# Comma-separated CIDRs of your reverse proxies (enables X-Forwarded-For handling).
TRUSTED_PROXIES=
# Comma-separated origins allowed to call the API from a browser (e.g. a Flutter web build).
# Browser WebSocket connections from any other origin are refused; native apps send no Origin.
CORS_ORIGINS=
